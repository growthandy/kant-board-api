# 복사해서 .env 로 쓴다: cp .env.example .env  (.env 는 절대 커밋하지 않는다)
DATABASE_URL=postgresql+asyncpg://board:board@localhost:5432/board
# openssl rand -hex 64 로 생성 (HS512 는 64바이트 이상 권장)
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
# 프론트엔드 출처를 콤마로 (예: http://localhost:3000,https://my-todo.vercel.app)
CORS_ORIGINS=http://localhost:3000
SQL_ECHO=false
LOGGING_MODE=info
